#!/bin/bash
# Wrapper that calls yt-dlp inside Jeeaaasus Docker container
# --- debug logging (added 2026-10-03): copy stderr to a log; bot still receives identical stderr ---
HERE="$(cd "$(dirname "$0")" && pwd)"
DBG_LOG="${YTDL_DEBUG_LOG:-/dev/null}"   # set e.g. YTDL_DEBUG_LOG=$HERE/logs/ytdl-debug.log to enable
echo "=== $(date '+%F %T.%3N') pid=$$ START args: $*" >> "$DBG_LOG"
exec 2> >(tee -a "$DBG_LOG" >&2; echo "=== $(date '+%F %T.%3N') pid=$$ END (stderr closed)" >> "$DBG_LOG")
# --- end debug logging ---

COOKIES="$HERE/cookies.txt"
DOCKER_OPTS=(--rm)
YTDLP_OPTS=()
if [ -f "$COOKIES" ]; then
  DOCKER_OPTS+=(-v "$COOKIES:/config/cookies.txt")
  YTDLP_OPTS+=(--cookies /config/cookies.txt)
fi

# The bot's arguments reach yt-dlp as positional parameters ("$@" inside sh -c), never as
# shell text, so apostrophes and other shell characters in a search arrive unchanged and
# cannot run commands in the container.
exec docker run "${DOCKER_OPTS[@]}"   -v "${YTDL_CACHE_DIR:-$HOME/.cache/yt-dlp-docker}":/cache -e XDG_CACHE_HOME=/cache   jeeaaasustest/youtube-dl:latest   sh -c 'exec yt-dlp "$@"' yt-dlp "${YTDLP_OPTS[@]}" --socket-timeout 5 --extractor-args youtube:skip=hls "$@"
